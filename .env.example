# Copy to .env and adjust. Nothing here is a secret: Webin credentials are
# entered in the browser and never read from the environment or written to disk.

# Port the server listens on (local dev and gunicorn alike).
# ENA_BROWSER_PORT=9200

# Server-side write lock. When true the /api/records/modify and
# /api/records/action endpoints refuse every request, whatever the UI's
# read-only toggle says. Leave true until you mean to write to ENA.
# ENA_BROWSER_READONLY=true

# Target ENA's test service (wwwdev) by default when the UI first loads. The
# UI can switch; this is only the initial value.
# ENA_BROWSER_TEST=true

# Django debug (local dev only).
# DJANGO_DEBUG=1
